<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MatMaker.MainWindow"
        Title="MatMaker"
        Icon="/Assets/logo_matmaker.ico"
        Width="840"
        Height="680"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="MatMaker" />
        <TextBlock x:Name="SubtitleText"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      </StackPanel>
      <ToggleButton x:Name="LanguageToggleButton"
                    Grid.Column="1"
                    Padding="12,8"
                    IsCheckedChanged="LanguageToggleButton_IsCheckedChanged">
        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10">
          <TextBlock x:Name="EnglishLanguageText" Text="Eng" />
          <TextBlock x:Name="SpanishLanguageText" Grid.Column="1" Text="Esp" />
        </Grid>
      </ToggleButton>
    </Grid>

    <Border Grid.Row="1"
            Padding="14"
            Background="{DynamicResource SystemControlHighlightAltLowBrush}"
            BorderBrush="{DynamicResource SystemControlHighlightAltAccentBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="4">
          <TextBlock x:Name="FileNameLabelText" FontWeight="SemiBold" />
          <TextBox x:Name="FileNameTextBox"
                   />
          <TextBlock x:Name="FileNameHintText"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
          <TextBlock x:Name="MatlabVariableLabelText" FontWeight="SemiBold" />
          <TextBlock FontFamily="Consolas, Menlo, monospace" FontSize="16" Text="Resultados" />
          <TextBlock x:Name="SameAsOriginalText"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Spacing="4">
      <TextBlock x:Name="PasteTableLabelText" FontWeight="SemiBold" />
      <TextBlock x:Name="PasteHintText"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </StackPanel>

    <TextBox x:Name="DataTextBox"
             Grid.Row="3"
             AcceptsReturn="True"
             FontFamily="Consolas, Menlo, monospace"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             TextWrapping="NoWrap"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             />

    <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <TextBlock x:Name="StatusText"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      <Button x:Name="ValidateButton" Grid.Column="1" Click="ValidateButton_Click" />
      <Button x:Name="SaveButton" Grid.Column="2"
              Padding="16,8"
              Click="SaveButton_Click" />
    </Grid>
  </Grid>
</Window>
